# Copy to .env for local use: node --env-file=.env server.js
PUBLIC_BASE_URL=http://localhost:8080
DB_PATH=./data/formtech.sqlite
# Generate a minimum 32-character secret. No default staff credentials exist.
SESSION_SECRET=
# JSON array generated with npm run user; see README. Keep out of Git.
STAFF_USERS_JSON=[]
# Leave unset until the new public number is purchased and tested.
PUBLIC_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEPHONY_ENABLED=false
# Private destinations, set in Fly secrets before switching on forwarding.
AUCKLAND_PHONE=
CHRISTCHURCH_PHONE=
SUPPORT_PHONE=
ORDERS_PHONE=
ACCOUNTS_PHONE=
# A nominated backup, only used when its destination is currently open.
AUCKLAND_BACKUP_PHONE=
CHRISTCHURCH_BACKUP_PHONE=
SUPPORT_BACKUP_PHONE=
ORDERS_BACKUP_PHONE=
ACCOUNTS_BACKUP_PHONE=
# Set true only after confirming the published store hours and CLOSED_DATES.
HOURS_CONFIRMED=false
# Comma-separated NZ local closure dates; maintain public holidays annually.
CLOSED_DATES=
# Optional overrides, example in README.
HOURS_JSON=
# Optional signed inbound-email bridge. This is not mailbox authentication.
EMAIL_WEBHOOK_SECRET=
# HubSpot owns support@. Supply a private app token with ticket read/write access.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_TICKET_PIPELINE=
HUBSPOT_TICKET_STAGE=
# Must exist as a UNIQUE string property on tickets before enabling sync.
HUBSPOT_REFERENCE_PROPERTY=formtech_reference
