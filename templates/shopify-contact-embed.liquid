<!-- Paste into a Custom liquid section on the Formtech contact page. -->
<div class="formtech-contact-embed">
  <iframe src="https://telephony-kidzwq.fly.dev/embed"
    title="Contact Formtech - sales, orders and support"
    width="100%" height="1550" loading="lazy"
    style="display:block;width:100%;border:0;min-height:400px;"
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <script>
    (() => {
      const frame = document.currentScript.previousElementSibling;
      window.addEventListener('message', (event) => {
        if (event.origin !== 'https://telephony-kidzwq.fly.dev' || event.source !== frame.contentWindow) return;
        if (event.data?.type !== 'formtech:resize' || !Number.isFinite(event.data.height)) return;
        frame.style.height = Math.max(400, Math.min(6000, Math.ceil(event.data.height) + 2)) + 'px';
      });
    })();
  </script>
  <p><a href="https://telephony-kidzwq.fly.dev/" target="_blank" rel="noopener">Open the Formtech contact form in a new tab</a></p>
</div>
